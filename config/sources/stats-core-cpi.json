{
  "id": "stats-core-cpi",
  "name": "国家统计局 · 核心CPI最新发布",
  "category": "macro",
  "kind": "script",
  "runtime": "python",
  "script": "scripts/stats_release.py",
  "args": [
    "--list",
    "{list}",
    "--keyword",
    "{keyword}"
  ],
  "vars": {
    "list": "https://www.stats.gov.cn/sj/zxfb/",
    "keyword": "居民消费价格"
  },
  "force": false,
  "tier": "official",
  "evidenceField": "核心CPI（不包括食品和能源）",
  "notes": "通用发布页解析：换 --var keyword 可取其他主题；请核对列名/单位。"
}
