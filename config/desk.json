  "memory": {
    "checkpointPct": 0.8,
    "indexDir": "runtime/memory",
    "stateDir": "runtime/memory",
    "topK": 5
  },
  "policy": {
    "planApprovalRoles": [
      "macro",
      "industry",
      "stock"
    ],
    "maxConflictRounds": 2
  },
  "planning": {
    "mode": {
      "macro": "guided",
      "industry": "guided",
      "stock": "guided",
      "audit": "fixed",
      "legal": "fixed",
      "trader": "fixed"
    },
    "semanticDedupe": true
  },
  "collect": {
    "enabled": true,
    "respectRobots": false,
    "delayMs": 1200,
    "timeoutMs": 30000,
    "maxBytes": 8388608,
    "cacheDir": "runtime/cache/collect",
    "autoNeed": true,
    "quotas": {
      "perAgent": {
        "maxRequestsPerRun": 60,
        "maxBytesPerRun": 52428800
      },
      "allowedDomains": []
    },
    "forceDefault": true
  },
  "watchdog": {
    "enabled": true,
    "intervalMs": 2000,
    "stepTimeoutMs": 1800000,
    "runTimeoutMs": 1800000,
    "workHeartbeatMs": 180000,
    "maxAttempts": 3,
    "backoffMs": 5000,
    "pauseOnExhausted": false,
    "progressTimeoutMs": 600000,
    "progressCooldownMs": 900000,
    "progressHardTimeoutMs": 1500000,
    "progressRequeueOnHard": false
  },
  "scheduler": {
    "autoRun": true,
    "maxConcurrency": 4,
    "leaseMs": 180000,
    "heartbeatMs": 15000,
    "wallMsByTier": { "fast": 600000, "strong": 2700000, "verify": 2700000 },
    "conflictCheck": true,
    "defaultMode": "parallel",
    "maxConcurrencyCap": 4,
    "perEmployeeConcurrency": 2,
    "useAgentLoop": true,
    "agentLoopRuntime": "dsh",
    "legacyTaskApi": false
  },
  "budgets": {
    "maxTokensPerCase": 0,
    "maxChildTokensPerParent": 1000000,
    "defaultWorkReserve": 60000,
    "reservationTtlMs": 1800000
  },
  "autonomy": {
    "mode": "supervised"
  },
  "features": {
    "simpleMode": true,
    "concurrency": true,
    "router": true,
    "watchdogActions": true,
    "demoMode": true
  },
  "crossReview": {
    "semantic": false,
    "note": "语义审阅较慢；设为 true 后正式报告前启用"
  }
